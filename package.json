{
  "name": "moveit-mcp",
  "version": "0.2.0",
  "description": "MCP server + CLI that lets coding agents migrate data between databases safely: dry-run first, staged loads, verified reconciliation, reversible.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "moveit": "dist/src/index.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "moveit.config.example.json"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test \"dist/test/**/*.test.js\"",
    "test:live": "npm run build && node --disable-warning=ExperimentalWarning --test --test-timeout=180000 \"dist/test/*.live.test.js\"",
    "start": "node dist/src/index.js mcp",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "csv-parse": "^5.6.0",
    "zod": "^3.25.0"
  },
  "optionalDependencies": {
    "@databricks/sql": "^1.9.0",
    "mysql2": "^3.11.0",
    "oracledb": "^6.7.0",
    "pg": "^8.13.0",
    "snowflake-sdk": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "data-migration",
    "postgres",
    "mysql",
    "oracle",
    "snowflake",
    "databricks",
    "sqlite",
    "csv",
    "claude-code",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YOUR-ORG/moveit-mcp.git"
  }
}
